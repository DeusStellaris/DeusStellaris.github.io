# Cabeceras de Cloudflare Pages: caché por tipo de recurso y seguridad para todo el sitio.
# Ver docs/setup/performance.md y docs/security/csp.md.

# Recursos con hash en el nombre (CSS, JS, fuentes, imágenes optimizadas): inmutables un año.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker: siempre revalidado para que las actualizaciones lleguen.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Datos públicos: caché corta y revalidación en segundo plano.
/search-index.json
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
/demos-index.json
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
/hub-resources.json
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
/manifest.webmanifest
  Cache-Control: public, max-age=3600

# Manifiesto firmado de DeusDeck: la app lo consulta desde otro origen y siempre debe leerse fresco.
/programas/deusdeck/version.json
  Access-Control-Allow-Origin: *
  Cache-Control: no-cache

# Archivos estáticos sin hash.
/js/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/demos/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Seguridad para todo el sitio. Complementa la CSP de <meta> que genera Astro (con hashes por página):
# varias CSP se intersecan, así que esta solo agrega lo que <meta> no puede expresar.
# Sin Cache-Control aquí: Cloudflare Pages une valores repetidos con comas y anularía los de arriba.
# El HTML usa el valor por defecto de Pages (max-age=0, must-revalidate).
# COOP same-origin-allow-popups: Decap CMS (/admin/) necesita window.opener en su ventana de OAuth.
/*
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=(), midi=(), browsing-topics=(), fullscreen=(self), gamepad=(self)
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin-allow-popups
