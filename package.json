{
  "name": "deus-portfolio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Portafolio personal de Deus. Sitio estático generado con Astro.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "ci": "biome check . && astro check && astro build"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.5",
    "typescript": "5.9.3"
  }
}
