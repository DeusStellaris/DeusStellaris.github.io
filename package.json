{
  "name": "deus-portfolio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Portafolio personal de Deus. Sitio estático generado con Astro.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "sync:decap": "node scripts/sync-decap.mjs",
    "predev": "npm run sync:decap",
    "dev": "astro dev",
    "prebuild": "npm run sync:decap",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "audit": "npm audit --omit=dev",
    "ci": "npm run sync:decap && biome check . && astro check && astro build && npm run test && npm run test:build",
    "test:unit": "node --test tests/unit/",
    "test:workers": "npm --prefix workers/decap-auth test && npm --prefix workers/api test",
    "test": "npm run test:unit && npm run test:workers",
    "test:build": "node --test tests/build/",
    "test:load": "k6 run tests/load/smoke.js",
    "test:e2e": "playwright test",
    "test:e2e:content": "node scripts/e2e-content.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/markdown-satteri": "0.4.3",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "1.64.1",
    "decap-cms-app": "3.17.1",
    "lighthouse": "13.5.0",
    "typescript": "5.9.3"
  }
}
