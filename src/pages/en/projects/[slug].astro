---
import type { Locale } from '../../../i18n';
import { projectPagePaths } from '../../../i18n/routes';
import ProjectLayout from '../../../layouts/ProjectLayout.astro';
import { listProjects, projectLocales } from '../../../services/projects';

export async function getStaticPaths() {
  const locale: Locale = 'en';
  const projects = await listProjects(locale);
  return Promise.all(
    projects.map(async (project) => ({
      params: { slug: project.slug },
      props: {
        locale,
        project,
        pagePaths: projectPagePaths(project.slug, await projectLocales(project.slug)),
      },
    })),
  );
}

const { locale, project, pagePaths } = Astro.props;
---

<ProjectLayout locale={locale} project={project} pagePaths={pagePaths} />
