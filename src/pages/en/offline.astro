---
import OfflineNotice from '../../components/layout/OfflineNotice.astro';
import { type Locale, t } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';

const locale: Locale = 'en';
---

<BaseLayout
  title={`${t(locale, 'offline.title')} · ${t(locale, 'common.siteName')}`}
  description={t(locale, 'offline.body')}
  locale={locale}
  pagePaths={{ es: '/offline/', en: '/offline/' }}
  assistant={false}
  noindex
>
  <OfflineNotice locale={locale} />
</BaseLayout>
