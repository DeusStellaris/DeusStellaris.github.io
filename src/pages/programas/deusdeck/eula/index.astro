---
import LegalDocument from '../../../../components/legal/LegalDocument.astro';
import { type Locale, t } from '../../../../i18n';
import { deckPaths, localizedHref } from '../../../../i18n/routes';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { DOCUMENTS } from '../../../../legal/documents';

const locale: Locale = 'es';
const title = DOCUMENTS.eula[locale].title;
---

<BaseLayout
  title={`${title} · ${t(locale, 'common.siteName')}`}
  description={t(locale, 'deck.eulaIntro')}
  locale={locale}
  section="programs"
  pagePaths={deckPaths('eula')}
>
  <div class="container">
    <LegalDocument locale={locale} kind="eula" />
    <p><a href={localizedHref(locale, deckPaths()[locale])}>{t(locale, 'deck.backToDeck')}</a></p>
  </div>
</BaseLayout>
