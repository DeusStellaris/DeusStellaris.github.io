---
import DeusDeckProduct from '../../../components/deusdeck/DeusDeckProduct.astro';
import { type Locale, t } from '../../../i18n';
import { deckPaths } from '../../../i18n/routes';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const locale: Locale = 'es';
---

<BaseLayout
  title={`DeusDeck · ${t(locale, 'common.siteName')}`}
  description={t(locale, 'deck.lead')}
  locale={locale}
  section="programs"
  pagePaths={deckPaths()}
>
  <div class="container">
    <DeusDeckProduct locale={locale} />
  </div>
</BaseLayout>
