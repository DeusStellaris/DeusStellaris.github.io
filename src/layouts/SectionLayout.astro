---
import DemoCards from '../components/demos/DemoCards.astro';
import DeckFeatured from '../components/deusdeck/DeckFeatured.astro';
import EmptyState from '../components/EmptyState.astro';
import FaqAccordion from '../components/faq/FaqAccordion.astro';
import SearchWidget from '../components/search/SearchWidget.astro';
import ProjectGrid from '../components/projects/ProjectGrid.astro';
import ContactLinks from '../components/sections/ContactLinks.astro';
import SectionIntro from '../components/sections/SectionIntro.astro';
import type { ContentSectionId } from '../config/sections';
import { type Locale, t } from '../i18n';
import { sectionCopy } from '../i18n/section-copy';
import { listDemos } from '../services/demos';
import { listProjects } from '../services/projects';
import BaseLayout from './BaseLayout.astro';

interface Props {
  locale: Locale;
  section: ContentSectionId;
}

const { locale, section } = Astro.props;
const copy = sectionCopy(locale, section);
// Contacto no tiene proyectos: solo muestra sus medios de contacto.
const projects = section === 'contact' ? [] : await listProjects(locale, { section });
const demos = section === 'games' ? listDemos() : [];
---

<BaseLayout
  title={`${copy.title} · ${t(locale, 'common.siteName')}`}
  description={copy.intro}
  locale={locale}
  section={section}
>
  <div class="container">
    <SectionIntro title={copy.title} intro={copy.intro} />
    {section !== 'contact' && <SearchWidget locale={locale} variant="section" scope={section} />}
    {section === 'programs' && <DeckFeatured locale={locale} />}
    {demos.length > 0 && <DemoCards locale={locale} demos={demos} />}
    {
      section === 'contact' ? (
        <ContactLinks locale={locale} />
      ) : projects.length > 0 ? (
        <ProjectGrid locale={locale} items={projects} />
      ) : (
        <EmptyState message={t(locale, 'projects.emptySection')} />
      )
    }
    {section === 'freelance' && <FaqAccordion locale={locale} />}
  </div>
</BaseLayout>
