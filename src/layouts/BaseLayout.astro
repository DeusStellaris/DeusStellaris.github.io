---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import AssistantButton from '../components/assistant/AssistantButton.astro';
import ConsentBanner from '../components/consent/ConsentBanner.astro';
import IntroOverlay from '../components/layout/IntroOverlay.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import ProfileDialog from '../components/profile/ProfileDialog.astro';
import NotificationsDialog from '../components/push/NotificationsDialog.astro';
import type { SectionId } from '../config/sections';
import siteConfig from '../config/site.json';
import { DEFAULT_LOCALE, LOCALES, type Locale, t } from '../i18n';
import { absoluteLocalizedUrl, sectionPaths, switchTargets } from '../i18n/routes';
import { publicAssetUrl } from '../lib/assets';

interface Props {
  /** Título completo de la pestaña, ya formateado por la página. */
  title: string;
  description: string;
  locale: Locale;
  /** Sección que identifica la página (identidad visual y marcador de navegación). */
  section?: SectionId;
  /**
   * Ruta sin prefijo de la página en cada idioma (p. ej. { es: '/proyectos/x/', en: '/projects/x/' }).
   * Si se omite y hay sección, se usan las rutas de la sección. Determina canonical,
   * hreflang y el destino del selector de idioma.
   */
  pagePaths?: Partial<Record<Locale, string>>;
  noindex?: boolean;
  /** El asistente flotante se oculta en páginas que ya son un buscador (evita dos buscadores). */
  assistant?: boolean;
}

const {
  title,
  description,
  locale,
  section,
  pagePaths,
  noindex = false,
  assistant = true,
} = Astro.props;

const siteName = t(locale, 'common.siteName');
const ogLocale = siteConfig.ogLocale[locale];
const paths: Partial<Record<Locale, string>> | undefined =
  pagePaths ?? (section ? sectionPaths(section) : undefined);
const canonicalUrl = paths?.[locale] ? absoluteLocalizedUrl(locale, paths[locale]) : undefined;
const switchHrefs = switchTargets(paths ?? {});
---

<!doctype html>
<html lang={locale} data-intro-policy={import.meta.env.DEV ? 'always' : 'session'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!--
      Tema, Lite Mode y bienvenida: script clásico, síncrono y lo más arriba posible del <head>.
      Se ejecuta antes de cualquier hoja de estilo o componente que dependa del tema y fija
      <html data-theme> antes del primer pintado. Externo (is:inline con src): cumple 'self' sin
      'unsafe-inline' y no requiere mantener hashes. Ver public/js/preferences-init.js.
    -->
    <script is:inline src={publicAssetUrl('js/preferences-init.js')}></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    {
      paths && canonicalUrl && (
        <>
          <link rel="canonical" href={canonicalUrl} />
          {LOCALES.filter((code) => paths[code] !== undefined).map((code) => (
            <link rel="alternate" hreflang={code} href={absoluteLocalizedUrl(code, paths[code] ?? '/')} />
          ))}
          {paths[DEFAULT_LOCALE] && (
            <link
              rel="alternate"
              hreflang="x-default"
              href={absoluteLocalizedUrl(DEFAULT_LOCALE, paths[DEFAULT_LOCALE])}
            />
          )}
        </>
      )
    }

    <meta property="og:type" content={pagePaths ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:locale" content={ogLocale} />

    <link rel="icon" href={publicAssetUrl('favicon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={publicAssetUrl('manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={publicAssetUrl('assets/icons/apple-touch-icon.png')} />
    <meta name="theme-color" content="#7C3AED" />

    <ClientRouter fallback="swap" />
  </head>
  <body data-section={section ?? 'home'}>
    <IntroOverlay locale={locale} />
    <a class="skip-link" href="#main">{t(locale, 'common.skipToContent')}</a>
    <SiteHeader locale={locale} section={section ?? 'home'} switchHrefs={switchHrefs} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <ProfileDialog locale={locale} />
    <NotificationsDialog locale={locale} />
    <ConsentBanner locale={locale} />
    {
      assistant && (
        <AssistantButton locale={locale} context={section && section !== 'home' ? section : undefined} />
      )
    }
    <script>
      import '../features/bootstrap';
    </script>
  </body>
</html>
