---
import { type Locale, t } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<!--
  Ranking de proyectos con filtro por categoría. Lo gestiona initRankings (src/features/likes/likes.ts).
  Los textos viajan en data-msg-* para que el script no contenga cadenas traducidas.
-->
<section
  class="ranking"
  data-ranking-root
  data-locale={locale}
  data-msg-loading={t(locale, 'ranking.loading')}
  data-msg-error={t(locale, 'ranking.error')}
  data-msg-unconfigured={t(locale, 'ranking.unconfigured')}
  data-msg-empty={t(locale, 'ranking.empty')}
  data-msg-position={t(locale, 'ranking.position')}
  data-msg-filter-all={t(locale, 'ranking.filterAll')}
  aria-labelledby="ranking-heading"
>
  <h1 id="ranking-heading">{t(locale, 'ranking.heading')}</h1>
  <p class="ranking__intro">{t(locale, 'ranking.intro')}</p>

  <div class="ranking__filter">
    <label for="ranking-category">{t(locale, 'ranking.filterLabel')}</label>
    <select id="ranking-category" data-ranking-filter>
      <option value="all">{t(locale, 'ranking.filterAll')}</option>
    </select>
  </div>

  <p class="ranking__status" role="status" aria-live="polite" data-ranking-status></p>
  <ol class="ranking__list" data-ranking-list></ol>
</section>

<style>
  .ranking {
    padding-block: var(--space-8) var(--space-24);
    max-width: 48rem;
  }

  .ranking__intro {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .ranking__filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-block: var(--space-6);
    font-size: var(--text-sm);
  }

  .ranking__filter select {
    min-height: var(--target-min);
    padding-inline: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .ranking__status {
    color: var(--color-text-muted);
  }

  .ranking__list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ranking__item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .ranking__position {
    color: var(--color-accent-strong);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ranking__meta {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
