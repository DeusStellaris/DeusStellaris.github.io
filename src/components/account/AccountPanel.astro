---
import { type Locale, t } from '../../i18n';

interface Props {
  locale: Locale;
  api: string;
}

const { locale, api } = Astro.props;
const messageKeys = [
  'working',
  'registered',
  'loggedIn',
  'invalid',
  'wrongCredentials',
  'taken',
  'rateLimited',
  'error',
] as const;
const messages = JSON.stringify(
  Object.fromEntries(messageKeys.map((key) => [key, t(locale, `account.${key}`)])),
);
---

{/*
  Cuenta opcional para respaldar el perfil. Solo se incluye en el perfil cuando services.json tiene
  accountsEnabled en true (apagada por defecto). Lo gestiona src/features/accounts/accounts.ts.
*/}
<section class="account" data-account data-api={api} data-messages={messages} aria-labelledby="account-title">
  <h3 id="account-title">{t(locale, 'account.heading')}</h3>
  <p class="account__intro">{t(locale, 'account.intro')}</p>
  <form class="account__form" data-account-form novalidate>
    <label for="account-email">{t(locale, 'account.emailLabel')}</label>
    <input id="account-email" name="email" type="email" autocomplete="email" maxlength="254" required />
    <label for="account-password">{t(locale, 'account.passwordLabel')}</label>
    <div class="account__password">
      <input id="account-password" name="password" type="password" autocomplete="current-password" minlength="12" maxlength="128" required />
      <button
        type="button"
        class="account__reveal"
        data-account-reveal
        data-label-show={t(locale, 'account.showPassword')}
        data-label-hide={t(locale, 'account.hidePassword')}
        aria-label={t(locale, 'account.showPassword')}
        data-tooltip={t(locale, 'account.showPassword')}
        aria-pressed="false"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12Z" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" />
          <circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.75" />
          <path class="account__slash" d="M4 4l16 16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
        </svg>
      </button>
    </div>
    <p class="account__hint">{t(locale, 'account.passwordHint')}</p>
    <p class="account__status" role="status" data-account-status></p>
    <div class="account__actions">
      <button type="submit" data-account-action="login" data-tooltip={t(locale, 'account.loginTooltip')}>
        {t(locale, 'account.login')}
      </button>
      <button type="submit" data-account-action="register" data-tooltip={t(locale, 'account.registerTooltip')}>
        {t(locale, 'account.register')}
      </button>
    </div>
  </form>
</section>

<style>
  .account__form {
    display: grid;
    gap: var(--space-2);
  }

  .account__intro,
  .account__hint,
  .account__status {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .account input {
    min-height: var(--target-min);
    padding-inline: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
  }

  /* Se oculta el ojo nativo del navegador: el propio tiene cursor, tooltip y etiqueta traducida. */
  .account__password {
    position: relative;
    display: grid;
  }

  .account__password input {
    padding-inline-end: calc(var(--target-min) + var(--space-1));
  }

  .account__password input::-ms-reveal {
    display: none;
  }

  .account__reveal {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    display: grid;
    place-items: center;
    width: var(--target-min);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .account__reveal:hover {
    color: var(--color-kintsugi);
  }

  .account__reveal svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .account__slash {
    opacity: 0;
  }

  .account__reveal[aria-pressed='true'] .account__slash {
    opacity: 1;
  }

  .account__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .account__actions button {
    min-height: var(--target-min);
    padding-inline: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface-raised);
    color: var(--color-text);
    cursor: pointer;
  }
</style>
