---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ContentSectionId } from '../../config/sections';
import { type Locale, t } from '../../i18n';
import FavoriteButton from '../favorites/FavoriteButton.astro';

interface Props {
  locale: Locale;
  slug: string;
  href: string;
  title: string;
  summary: string;
  section: ContentSectionId;
  cover: { image: ImageMetadata; alt: string };
  publishedLabel: string;
  categoryLabel: string | undefined;
  featured: boolean;
}

const {
  locale,
  slug,
  href,
  title,
  summary,
  section,
  cover,
  publishedLabel,
  categoryLabel,
  featured,
} = Astro.props;
---

<article class="project-card" data-card-section={section}>
  <div class="project-card__favorite">
    <FavoriteButton locale={locale} slug={slug} />
  </div>
  <a class="project-card__link" href={href}>
    <div class="project-card__media">
      <Picture
        src={cover.image}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200]}
        sizes="(min-width: 64em) 25vw, (min-width: 48em) 50vw, 100vw"
        alt={cover.alt}
        loading="lazy"
        decoding="async"
      />
      {featured && <span class="project-card__badge">{t(locale, 'projects.featured')}</span>}
    </div>
    <div class="project-card__body">
      <p class="project-card__meta">
        {categoryLabel && <span>{categoryLabel}</span>}
        <time>{publishedLabel}</time>
      </p>
      <h3 class="project-card__title">{title}</h3>
      <p class="project-card__summary">{summary}</p>
      <span class="project-card__cta">{t(locale, 'projects.viewProject')} →</span>
    </div>
  </a>
</article>

<style>
  .project-card {
    position: relative;
    height: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    overflow: hidden;
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .project-card__favorite {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    z-index: 2;
  }

  .project-card:hover {
    border-color: var(--color-accent);
  }

  .project-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }

  .project-card__media {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--color-surface-raised);
  }

  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-card__badge {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    color: var(--color-accent-strong);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-6) var(--space-6);
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .project-card__title {
    margin: 0;
    font-size: var(--text-xl);
  }

  .project-card__summary {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .project-card__cta {
    margin-top: auto;
    color: var(--color-accent-strong);
    font-size: var(--text-sm);
  }
</style>
