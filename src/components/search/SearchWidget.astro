---
import { NAV_SECTIONS, type SectionId } from '../../config/sections';
import { type Locale, type TranslationKey, t } from '../../i18n';

interface Props {
  locale: Locale;
  /** 'page' muestra el filtro por sección; 'compact' es la versión del asistente. */
  variant: 'page' | 'compact';
  /** Sección de la página actual: sus resultados aparecen primero. */
  context?: SectionId | undefined;
  /** Si es true, lee ?q= de la URL al cargar. */
  prefillFromUrl?: boolean;
}

const { locale, variant, context, prefillFromUrl = false } = Astro.props;
const id = `search-${variant}`;
const FILTER_KEYS: Record<(typeof NAV_SECTIONS)[number], TranslationKey> = {
  games: 'nav.games',
  programs: 'nav.programs',
  freelance: 'nav.freelance',
  contact: 'nav.contact',
};
---

<!--
  Buscador reutilizable. El comportamiento lo gestiona src/features/search/search-widget.ts.
  Los mensajes viajan en data-msg-* para que el script no contenga texto traducido.
-->
<section
  class:list={['search-widget', `search-widget--${variant}`]}
  data-search-widget
  data-context={context ?? ''}
  data-prefill-from-url={prefillFromUrl ? 'true' : 'false'}
  data-msg-loading={t(locale, 'search.loading')}
  data-msg-error={t(locale, 'search.error')}
  data-msg-hint={t(locale, 'search.hint')}
  data-msg-no-results={t(locale, 'search.noResults')}
  data-msg-count={t(locale, 'search.resultsCount')}
  data-msg-type-section={t(locale, 'search.typeSection')}
  data-msg-type-project={t(locale, 'search.typeProject')}
  aria-labelledby={`${id}-heading`}
>
  {
    variant === 'page' && (
      <h1 id={`${id}-heading`}>{t(locale, 'search.heading')}</h1>
    )
  }
  {
    variant === 'compact' && (
      <h2 id={`${id}-heading`} class="visually-hidden">{t(locale, 'assistant.title')}</h2>
    )
  }

  <form class="search-widget__form" role="search" data-search-form>
    <label class="visually-hidden" for={`${id}-input`}>{t(locale, 'search.label')}</label>
    <div class="search-widget__row">
      <input
        id={`${id}-input`}
        class="search-widget__input"
        type="search"
        name="q"
        autocomplete="off"
        spellcheck="false"
        placeholder={t(locale, 'search.placeholder')}
        data-search-input
      />
      <button type="button" class="search-widget__button" data-search-clear>
        {t(locale, 'search.clear')}
      </button>
    </div>

    {
      variant === 'page' && (
        <div class="search-widget__filter">
          <label for={`${id}-filter`}>{t(locale, 'search.filterLabel')}</label>
          <select id={`${id}-filter`} data-search-filter>
            <option value="all">{t(locale, 'search.filterAll')}</option>
            {NAV_SECTIONS.map((section) => (
              <option value={section}>{t(locale, FILTER_KEYS[section])}</option>
            ))}
          </select>
        </div>
      )
    }
  </form>

  <p class="search-widget__status" role="status" aria-live="polite" data-search-status>
    {t(locale, 'search.hint')}
  </p>
  <button type="button" class="search-widget__button" data-search-retry hidden>
    {t(locale, 'search.retry')}
  </button>
  <ul class="search-widget__results" aria-labelledby={`${id}-heading`} data-search-results></ul>
</section>

<style>
  .search-widget__form {
    display: grid;
    gap: var(--space-3);
  }

  .search-widget__row {
    display: flex;
    gap: var(--space-2);
  }

  .search-widget__input {
    flex: 1;
    min-height: var(--target-min);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .search-widget__input:focus-visible {
    border-color: var(--color-accent);
  }

  .search-widget__button {
    min-height: var(--target-min);
    padding-inline: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface-raised);
    color: var(--color-text);
    cursor: pointer;
  }

  .search-widget__filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .search-widget__filter select {
    min-height: var(--target-min);
    padding-inline: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .search-widget__status {
    margin: var(--space-4) 0 var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .search-widget__results {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .search-result {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .search-result__title {
    font-weight: 600;
  }

  .search-result__meta {
    margin: var(--space-1) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .search-result__summary {
    margin: var(--space-1) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .search-widget--page {
    max-width: 44rem;
    padding-block: var(--space-8) var(--space-24);
  }
</style>
