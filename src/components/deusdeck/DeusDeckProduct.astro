---
import { type Locale, t } from '../../i18n';
import { deckPaths, localizedHref } from '../../i18n/routes';
import ProjectNotifyButton from '../push/ProjectNotifyButton.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const FEATURES = ['lan', 'obs', 'emoji', 'soundboard', 'pc', 'setups'] as const;
const href = (sub: 'hub' | 'eula') => localizedHref(locale, deckPaths(sub)[locale]);
const legalLinks = [
  {
    href: href('eula'),
    label: t(locale, 'deck.legalEula'),
    tip: t(locale, 'deck.legalEulaTooltip'),
  },
  {
    href: localizedHref(locale, locale === 'es' ? '/privacidad/' : '/privacy/'),
    label: t(locale, 'deck.legalPrivacy'),
    tip: t(locale, 'deck.legalPrivacyTooltip'),
  },
  {
    href: localizedHref(locale, locale === 'es' ? '/terminos/' : '/terms/'),
    label: t(locale, 'deck.legalTerms'),
    tip: t(locale, 'deck.legalTermsTooltip'),
  },
];
const MANIFEST_URL = '/programas/deusdeck/version.json';
const PLATFORMS = ['windows', 'android'] as const;
const noteLabels = JSON.stringify({
  added: t(locale, 'deck.notesAdded'),
  improved: t(locale, 'deck.notesImproved'),
  fixed: t(locale, 'deck.notesFixed'),
});
const osNames = JSON.stringify({
  windows: t(locale, 'deck.os.windows'),
  mac: t(locale, 'deck.os.mac'),
  linux: t(locale, 'deck.os.linux'),
  other: t(locale, 'deck.os.other'),
});
---

<article
  class="deck"
  data-deck-product
  data-locale={locale}
  data-manifest-url={MANIFEST_URL}
  data-os-names={osNames}
  data-note-labels={noteLabels}
>
  <header class="deck__hero">
    <p class="deck__eyebrow">
      <span>{t(locale, 'deck.programsLabel')}</span>
      <span class="deck__badge" data-tooltip={t(locale, 'deck.statusBody')}>{t(locale, 'deck.badge')}</span>
    </p>
    <h1>DeusDeck</h1>
    <p class="deck__lead">{t(locale, 'deck.lead')}</p>
    <ProjectNotifyButton locale={locale} slug="deusdeck" title="DeusDeck" />
  </header>

  <section class="deck__status" aria-labelledby="deck-status-title">
    <h2 id="deck-status-title">{t(locale, 'deck.statusTitle')}</h2>
    <p>{t(locale, 'deck.statusBody')}</p>
  </section>

  <section aria-labelledby="deck-features-title">
    <h2 id="deck-features-title">{t(locale, 'deck.featuresHeading')}</h2>
    <ol class="deck__features">
      {
        FEATURES.map((id, index) => (
          <li class="deck__feature">
            <span class="deck__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3>{t(locale, `deck.features.${id}.title`)}</h3>
            <p>{t(locale, `deck.features.${id}.body`)}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="deck__download" aria-labelledby="deck-download-title">
    <h2 id="deck-download-title">{t(locale, 'deck.downloadHeading')}</h2>
    <p class="deck__os">
      {t(locale, 'deck.detectedOs')}: <strong data-deck-os>{t(locale, 'deck.os.windows')}</strong>
    </p>
    <p class="deck__notice" data-deck-unsupported hidden>{t(locale, 'deck.windowsOnly')}</p>
    <p class="deck__notice" data-deck-error hidden>
      {t(locale, 'deck.manifestError')} <a href={MANIFEST_URL}>version.json</a>
    </p>
    <noscript><p class="deck__notice">{t(locale, 'deck.noScript')} <a href={MANIFEST_URL}>version.json</a></p></noscript>

    <div data-deck-manifest hidden>
      <p class="deck__version">{t(locale, 'deck.versionLabel')}: <strong data-deck-version></strong></p>
      <div class="deck__installers">
        {
          PLATFORMS.map((platform) => (
            <a class="deck__button deck__button--primary" data-deck-download={platform} aria-disabled="true" data-tooltip={t(locale, `deck.${platform}Tooltip`)}>
              {t(locale, `deck.${platform}Label`)} <small data-deck-size={platform}></small>
            </a>
          ))
        }
      </div>

      <h3>{t(locale, 'deck.hashHeading')}</h3>
      <p class="deck__hint">{t(locale, 'deck.hashHelp')}</p>
      <dl class="deck__hashes">
        {
          PLATFORMS.map((platform) => (
            <>
              <dt data-tooltip={t(locale, 'deck.hashTooltip')}>{t(locale, `deck.${platform}Label`)}</dt>
              <dd><code data-deck-sha={platform}></code></dd>
            </>
          ))
        }
      </dl>

      <h3>{t(locale, 'deck.notesHeading')}</h3>
      <div data-deck-notes></div>
    </div>
  </section>

  <section aria-labelledby="deck-pair-title">
    <h2 id="deck-pair-title">{t(locale, 'deck.pairHeading')}</h2>
    <ol class="deck__steps">
      {(['1', '2', '3'] as const).map((n) => <li>{t(locale, `deck.pairStep${n}`)}</li>)}
    </ol>
  </section>

  <section class="deck__hub" aria-labelledby="deck-hub-title">
    <h2 id="deck-hub-title">{t(locale, 'deck.hubTitle')}</h2>
    <p>{t(locale, 'deck.hubBody')}</p>
    <a class="deck__button deck__button--primary" href={href('hub')} data-tooltip={t(locale, 'deck.hubTooltip')}>
      {t(locale, 'deck.hubLink')}
    </a>
  </section>

  <section aria-labelledby="deck-legal-title">
    <h2 id="deck-legal-title">{t(locale, 'deck.legalHeading')}</h2>
    <nav class="deck__legal" aria-label={t(locale, 'deck.legalHeading')}>
      {legalLinks.map((link) => <a class="deck__button" href={link.href} data-tooltip={link.tip}>{link.label}</a>)}
    </nav>
    <p class="deck__legal-note">{t(locale, 'deck.legalNote')}</p>
  </section>

</article>

<style>
  .deck {
    display: grid;
    gap: var(--space-12);
    padding-block: var(--space-12) var(--space-16);
  }

  .deck h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 9vw, 5.5rem);
    line-height: 1;
    letter-spacing: 0.01em;
  }

  .deck h2 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xl);
  }

  .deck h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-base);
  }

  .deck__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin: 0 0 var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .deck__badge {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-pill);
    color: var(--color-accent-strong);
    letter-spacing: 0.06em;
  }

  .deck__lead {
    max-width: 38rem;
    margin: var(--space-4) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .deck__status {
    padding: var(--space-4) var(--space-6);
    border-left: 3px solid var(--color-accent);
    background: var(--color-glow);
    border-radius: var(--radius-md);
  }

  .deck__status h2 {
    font-size: var(--text-base);
  }

  .deck__status p {
    margin: 0;
  }

  .deck__features {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .deck__feature {
    display: grid;
    grid-template-columns: 3rem 1fr;
    column-gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .deck__feature h3,
  .deck__feature p {
    grid-column: 2;
  }

  .deck__feature p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .deck__index {
    grid-row: 1 / span 2;
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: var(--text-lg);
  }

  @media (min-width: 48em) {
    .deck__features {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-8);
    }
  }

  .deck__os {
    margin: 0 0 var(--space-3);
  }

  .deck__notice {
    margin: 0 0 var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-md);
  }

  .deck__version {
    margin: 0 0 var(--space-4);
  }

  .deck__notice[hidden],
  [data-deck-manifest][hidden] {
    display: none;
  }

  .deck__installers,
  .deck__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .deck__button[aria-disabled='true'] {
    pointer-events: none;
    opacity: 0.6;
  }

  .deck__button small {
    margin-left: var(--space-2);
    color: var(--color-text-muted);
  }

  .deck__hint,
  .deck__legal-note {
    margin: var(--space-2) 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .deck__hashes {
    display: grid;
    gap: var(--space-1) var(--space-4);
    margin: 0 0 var(--space-6);
  }

  .deck__hashes dt {
    width: fit-content;
    font-size: var(--text-sm);
  }

  .deck__hashes dd {
    margin: 0 0 var(--space-3);
  }

  .deck__hashes code {
    overflow-wrap: anywhere;
    font-size: var(--text-sm);
  }

  .deck__notes,
  .deck__steps {
    margin: 0 0 var(--space-3);
    padding-left: var(--space-6);
  }

  .deck__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--target-min);
    padding-inline: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface-raised);
    color: var(--color-text);
    font-size: var(--text-sm);
    text-decoration: none;
    cursor: pointer;
  }

  .deck__button--primary {
    border-color: var(--color-accent);
    color: var(--color-accent-strong);
  }

  .deck__hub p {
    max-width: 38rem;
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
  }
</style>
