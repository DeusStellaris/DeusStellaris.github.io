---
import { type Locale, t } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<!-- Abre el panel de preferencias de notificaciones (NotificationsDialog.astro). -->
<button
  type="button"
  class="icon-button"
  data-push-open
  aria-label={`${t(locale, 'push.open')}. ${t(locale, 'push.openHint')}`}
  data-tooltip={t(locale, 'push.openHint')}
>
  <svg class="push-button__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path
      d="M6 9a6 6 0 1 1 12 0c0 6 2 7 2 7H4s2-1 2-7zM10 20a2 2 0 0 0 4 0"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
</button>

<style>
  .push-button__icon {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
