---
import { type Locale, t } from '../../i18n';
import {
  LEGAL_SEGMENT,
  localizedHref,
  RANKING_SEGMENT,
  SEARCH_SEGMENT,
  sectionHref,
} from '../../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="site-footer__text">{t(locale, 'common.siteName')} · {year}</p>
    <nav aria-label={t(locale, 'nav.primaryLabel')}>
      <ul class="site-footer__links">
        <li><a href={localizedHref(locale, `/${SEARCH_SEGMENT[locale]}/`)}>{t(locale, 'nav.search')}</a></li>
        <li><a href={localizedHref(locale, `/${RANKING_SEGMENT[locale]}/`)}>{t(locale, 'nav.ranking')}</a></li>
        <li><a href={localizedHref(locale, `/${LEGAL_SEGMENT.terms[locale]}/`)}>{t(locale, 'legal.footerTerms')}</a></li>
        <li><a href={localizedHref(locale, `/${LEGAL_SEGMENT.privacy[locale]}/`)}>{t(locale, 'legal.footerPrivacy')}</a></li>
        <li><a href={localizedHref(locale, `/${LEGAL_SEGMENT.cookies[locale]}/`)}>{t(locale, 'legal.footerCookies')}</a></li>
        <li><a href={localizedHref(locale, `/${LEGAL_SEGMENT.refund[locale]}/`)}>{t(locale, 'legal.footerRefund')}</a></li>
        <li>
          <button type="button" class="site-footer__reopen" data-consent-reopen data-tooltip={t(locale, 'consent.openTooltip')}>
            {t(locale, 'consent.open')}
          </button>
        </li>
      </ul>
    </nav>
    <p class="site-footer__request">
      <a href={sectionHref('contact', locale)}>{t(locale, 'legal.dataDeletionRequest')}</a>
    </p>
  </div>
</footer>

<style>
  /* Botón de preferencias de cookies: se ve como un enlace más del pie. */
  .site-footer__reopen {
    min-height: var(--target-min);
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  .site-footer {
    margin-top: var(--space-24);
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .site-footer__text,
  .site-footer__request {
    margin: 0;
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
  }
</style>
