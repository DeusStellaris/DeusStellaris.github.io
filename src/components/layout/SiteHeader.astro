---
import { NAV_SECTIONS, type NavSectionId, type SectionId } from '../../config/sections';
import { type Locale, type TranslationKey, t } from '../../i18n';
import { sectionHref } from '../../i18n/routes';
import ProfileButton from '../profile/ProfileButton.astro';
import NotificationsButton from '../push/NotificationsButton.astro';
import LanguagePill from '../ui/LanguagePill.astro';
import LiteModeToggle from '../ui/LiteModeToggle.astro';
import Logo from '../ui/Logo.astro';
import SectionIcon from '../ui/SectionIcon.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';

interface Props {
  locale: Locale;
  section: SectionId;
  /** La barra de secciones se oculta solo en la portada, donde las secciones ya son tarjetas. */
  showNav: boolean;
  /** Destino del selector de idioma por cada locale (página equivalente). */
  switchHrefs: Record<Locale, string>;
}

const { locale, section, showNav, switchHrefs } = Astro.props;

const NAV_LABEL_KEYS: Record<NavSectionId, TranslationKey> = {
  games: 'nav.games',
  programs: 'nav.programs',
  freelance: 'nav.freelance',
  contact: 'nav.contact',
};
---

<header class:list={['site-header', { 'site-header--home': !showNav }]}>
  <div class="container site-header__inner">
    <Logo locale={locale} />

    {
      showNav && (
    <nav class="site-nav" aria-label={t(locale, 'nav.primaryLabel')}>
      <ul class="site-nav__list">
        {
          NAV_SECTIONS.map((item) => {
            const active = item === section;
            return (
              <li>
                <a class="site-nav__link" href={sectionHref(item, locale)} aria-current={active ? 'page' : undefined}>
                  {active && (
                    // Marcador de sección: se desplaza hasta su posición con View Transitions.
                    <span class="site-nav__marker">
                      <SectionIcon section={item} />
                    </span>
                  )}
                  <span>{t(locale, NAV_LABEL_KEYS[item])}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
      )
    }

    <div class="site-header__controls">
      <ProfileButton locale={locale} />
      <NotificationsButton locale={locale} />
      <LiteModeToggle locale={locale} />
      <ThemeToggle locale={locale} />
      <LanguagePill locale={locale} hrefs={switchHrefs} />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-2);
  }

  .site-nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    padding-inline: var(--space-3);
    border-radius: var(--radius-pill);
    text-decoration: none;
    color: var(--color-text-muted);
    transition: color var(--duration-fast);
  }

  .site-nav__link:hover {
    color: var(--color-text);
  }

  .site-nav__link[aria-current='page'] {
    color: var(--color-accent-strong);
    background: var(--color-surface-raised);
  }

  /*
   * Marcador de sección: se desplaza entre enlaces con View Transitions. Se declara con CSS
   * (view-transition-name) en lugar de transition:name de Astro, que inyecta un <style> en línea
   * que la CSP no puede verificar con hash.
   */
  .site-nav__marker {
    view-transition-name: section-marker;
    display: inline-flex;
    color: var(--color-accent-strong);
  }

  .site-header__controls {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /*
   * Móvil (≤ 767 px): tres filas ordenadas en una grilla de 4 columnas. Fila 1: logotipo e idioma.
   * Fila 2: las cuatro secciones, una por columna, separadas por un divisor. Fila 3: los cuatro
   * botones de ajustes repartidos, para que no se lean como íconos de las secciones.
   * El encabezado deja de ser fijo para no ocupar casi un cuarto de la pantalla al desplazarse.
   */
  @media (max-width: 47.99em) {
    .site-header {
      position: static;
    }

    .site-header__inner {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-2) 0;
    }

    .site-header__inner > :global(.logo) {
      grid-area: 1 / 1 / 2 / 3;
      justify-self: start;
    }

    .site-header__controls {
      display: contents;
    }

    .site-header__controls :global(.lang-pill) {
      grid-area: 1 / 3 / 2 / 5;
      justify-self: end;
    }

    .site-header__controls :global(.icon-button) {
      grid-row: 3;
      justify-self: center;
    }

    .site-header--home :global(.icon-button) {
      grid-row: 2;
    }

    .site-nav {
      grid-area: 2 / 1 / 3 / 5;
      border-bottom: 1px solid var(--color-border);
    }

    .site-nav__list {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
    }

    .site-nav__link {
      justify-content: center;
      padding-inline: var(--space-1);
      font-size: clamp(0.75rem, 3.4vw, var(--text-sm));
    }

    .site-nav__marker {
      display: none;
    }
  }

  /* Botón circular compartido por los controles del header (≥ 44 px de objetivo táctil). */
  :global(.icon-button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--target-min);
    min-height: var(--target-min);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
    transition:
      transform var(--duration-fast),
      border-color var(--duration-fast);
  }

  :global(.icon-button:hover) {
    border-color: var(--color-accent);
  }

  :global(.icon-button:active) {
    transform: scale(0.94);
  }
</style>
