---
import services from '../../config/services.json';
import { type Locale, t } from '../../i18n';
import AccountPanel from '../account/AccountPanel.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

/** Opciones del panel de ajustes: textos y impacto en recursos ya traducidos. */
const impactLabels = ['Ram', 'Vram', 'Cpu', 'Battery'] as const;
function settingsInfo(prefix: 'lite' | 'theme'): string {
  return JSON.stringify({
    title: t(locale, `profile.${prefix}Title`),
    text: t(locale, `profile.${prefix}Text`),
    impact: impactLabels.map((name) => ({
      label: t(locale, `profile.impact${name}`),
      value: t(locale, `profile.${prefix}${name}`),
    })),
  });
}
---

{/*
  Perfil local: favoritos y preferencias. Lo gestiona src/features/profile/profile.ts.
  El <dialog> modal aporta foco, Escape y retorno del foco de forma nativa.
*/}
<dialog
  class="profile"
  data-profile-dialog
  data-locale={locale}
  aria-labelledby="profile-title"
  data-msg-no-favorites={t(locale, 'profile.noFavorites')}
  data-msg-unavailable={t(locale, 'favorites.unavailable')}
  data-msg-remove={t(locale, 'profile.remove')}
>
  <div class="profile__inner">
    <header class="profile__header">
      <h2 id="profile-title">{t(locale, 'profile.title')}</h2>
      <button
        type="button"
        class="profile__close"
        data-profile-close
        data-tooltip={t(locale, 'profile.closeTooltip')}
        aria-label={t(locale, 'profile.close')}
      >
        <span aria-hidden="true">×</span>
      </button>
    </header>

    <div class="profile__body">
    <p class="profile__privacy">{t(locale, 'profile.privacy')}</p>

    <section class="profile__section" aria-labelledby="profile-favorites-heading">
      <h3 id="profile-favorites-heading">{t(locale, 'profile.favoritesHeading')}</h3>
      <div data-profile-favorites></div>
      <button type="button" class="profile__clear" data-profile-clear>{t(locale, 'profile.clearAll')}</button>
    </section>

    <section class="profile__section" aria-labelledby="profile-prefs-heading">
      <h3 id="profile-prefs-heading">{t(locale, 'profile.preferencesHeading')}</h3>
      <p class="settings__hint">{t(locale, 'profile.settingsHint')}</p>
      <ul class="settings" role="list" data-msg-saved={t(locale, 'toast.preferenceSaved')}>
        <li>
          <button
            type="button"
            class="settings__row"
            data-settings-row
            data-settings-info={settingsInfo('lite')}
            data-settings-toggle="lite"
            data-state-on={t(locale, 'profile.on')}
            data-state-off={t(locale, 'profile.off')}
          >
            <span>{t(locale, 'profile.liteLabel')}</span>
            <span class="settings__state" data-settings-state></span>
          </button>
        </li>
        <li>
          <button
            type="button"
            class="settings__row"
            data-settings-row
            data-settings-info={settingsInfo('theme')}
            data-settings-toggle="theme"
            data-state-on={t(locale, 'profile.themeLight')}
            data-state-off={t(locale, 'profile.themeDark')}
          >
            <span>{t(locale, 'profile.themeLabel')}</span>
            <span class="settings__state" data-settings-state></span>
          </button>
        </li>
      </ul>
    </section>

    {services.accountsEnabled === true && <AccountPanel locale={locale} api={services.apiBaseUrl ?? ''} />}
    </div>

    <footer class="profile__detail" data-settings-detail aria-live="polite">
      <h4 data-settings-title></h4>
      <p data-settings-text></p>
      <p class="profile__detail-label">{t(locale, 'profile.impactLabel')}</p>
      <dl class="profile__impact" data-settings-impact></dl>
    </footer>
  </div>
</dialog>

<style>
  .profile {
    width: min(92vw, 36rem);
    max-height: 85dvh;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
  }

  /* Contenedor externo sin scroll; solo el cuerpo se desplaza y la cabecera queda fija. */
  .profile__inner {
    display: flex;
    flex-direction: column;
    max-height: 85dvh;
  }

  .profile__body {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-6);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .profile__header {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4) var(--space-3) var(--space-6);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .profile__header h2 {
    margin: 0;
    font-size: var(--text-xl);
  }

  .profile__privacy {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .profile__section h3 {
    font-size: var(--text-base);
    font-weight: 600;
  }

  .profile__list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .profile__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .profile__empty {
    color: var(--color-text-muted);
  }

  .settings {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .settings__hint {
    margin: 0 0 var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .settings__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    width: 100%;
    min-height: var(--target-min);
    padding-inline: var(--space-4);
    border: 1px solid var(--color-border);
    border-left: 3px solid transparent;
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    color: var(--color-text);
    cursor: pointer;
    text-align: start;
    transition:
      transform var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .settings__row:hover,
  .settings__row[data-selected] {
    border-left-color: var(--color-kintsugi);
    transform: translateX(2px);
  }

  .settings__state {
    color: var(--color-kintsugi);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  /* Panel fijo inferior: descripción de la opción elegida e impacto en recursos. */
  .profile__detail {
    padding: var(--space-3) var(--space-6) var(--space-4);
    border-top: 1px solid var(--color-kintsugi);
    background:
      linear-gradient(155deg, rgb(124 58 237 / 0.14), transparent 50%),
      var(--color-surface);
    font-size: var(--text-sm);
  }

  .profile__detail h4 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-base);
  }

  .profile__detail p {
    margin: 0 0 var(--space-2);
    color: var(--color-text-muted);
  }

  .profile__detail .profile__detail-label {
    margin: 0 0 var(--space-1);
    color: var(--color-kintsugi);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .profile__impact {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-1) var(--space-3);
    margin: 0;
  }

  .profile__impact dt {
    font-weight: 600;
  }

  .profile__impact dd {
    margin: 0;
    color: var(--color-text-muted);
  }

  /* Móvil: todo el perfil scrollea de corrido; el panel de impacto deja de quedar fijo y tapar campos. */
  @media (max-width: 45em) {
    .profile__inner {
      overflow-y: auto;
    }

    .profile__body {
      overflow: visible;
    }

    .profile__detail {
      position: static;
    }
  }

  .profile__close {
    display: grid;
    place-items: center;
    width: var(--target-min);
    padding: 0;
    font-size: var(--text-xl);
    line-height: 1;
  }

  .profile__close,
  .profile__clear,
  .profile__remove {
    min-height: var(--target-min);
    padding-inline: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface-raised);
    color: var(--color-text);
    cursor: pointer;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .profile__close:hover {
    transform: rotate(90deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .profile__close:hover,
    .settings__row:hover,
    .settings__row[data-selected] {
      transform: none;
    }
  }

  .profile__clear {
    margin-top: var(--space-3);
  }
</style>
