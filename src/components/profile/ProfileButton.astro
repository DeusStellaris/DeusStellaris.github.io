---
import { type Locale, t } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

{/* Abre el perfil local (src/components/profile/ProfileDialog.astro). */}
<button
  type="button"
  class="icon-button profile-button"
  data-profile-open
  aria-label={t(locale, 'profile.open')}
  data-tooltip={t(locale, 'profile.openTooltip')}
>
  <svg class="profile-button__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="1.75" />
    <path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
  </svg>
</button>

<style>
  .profile-button__icon {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
