---
import services from '../../config/services.json';
import { type Locale, t } from '../../i18n';

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
// Sin URL de la API (services.json) el botón queda deshabilitado con su motivo visible.
const apiBaseUrl = services.apiBaseUrl ?? '';
const available = apiBaseUrl !== '';
---

{/*
  Botón de me gusta. Lo gestiona src/features/likes/likes.ts.
  El estado "pulsado" es aria-pressed; el texto cambia con CSS según ese estado.
*/}
<div class="like">
  <button
    type="button"
    class="like__button"
    data-like-toggle
    data-slug={slug}
    data-api={apiBaseUrl}
    data-count-template={t(locale, 'likes.count')}
    data-msg-error={t(locale, 'likes.error')}
    aria-pressed="false"
    disabled={!available}
  >
    <span class="like__label like__label--off">{t(locale, 'likes.like')}</span>
    <span class="like__label like__label--on">{t(locale, 'likes.liked')}</span>
    <span class:list={['like__count', { skeleton: available }]} data-like-count></span>
  </button>
  <p class="like__status" aria-live="polite" data-like-status>
    {!available && t(locale, 'likes.unconfigured')}
  </p>
</div>

<style>
  .like__button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    padding-inline: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
  }

  .like__button:hover:not(:disabled) {
    border-color: var(--color-accent);
  }

  .like__button:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  .like__button[aria-pressed='true'] {
    color: var(--color-accent-strong);
    border-color: var(--color-accent);
  }

  .like__label--on,
  .like__button[aria-pressed='false'] .like__label--on {
    display: none;
  }

  .like__button[aria-pressed='true'] .like__label--on {
    display: inline;
  }

  .like__button[aria-pressed='true'] .like__label--off {
    display: none;
  }

  .like__count {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* Reserva el ancho de la cifra mientras llega del Worker: evita saltos de diseño. */
  .like__count:global(.skeleton) {
    display: inline-block;
    width: 3.5rem;
    height: 1em;
  }

  .like__status {
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
