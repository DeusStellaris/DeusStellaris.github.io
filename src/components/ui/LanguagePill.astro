---
import type { SectionId } from '../../config/sections';
import { LOCALE_NAMES, LOCALES, type Locale, t } from '../../i18n';
import { sectionHref } from '../../i18n/routes';

interface Props {
  locale: Locale;
  section: SectionId;
}

const { locale, section } = Astro.props;
---

<!--
  Selector ES/EN tipo Sliding Pill. Es solo navegación entre URLs equivalentes:
  no necesita JavaScript. El indicador se desplaza según data-locale (sin estilos inline,
  porque la CSP no permite atributos style).
-->
<nav class="lang-pill" data-locale={locale} aria-label={t(locale, 'common.languageSwitchLabel')}>
  <span class="lang-pill__indicator" aria-hidden="true"></span>
  {
    LOCALES.map((code) => (
      <a
        class="lang-pill__option"
        href={sectionHref(section, code)}
        hreflang={code}
        lang={code}
        aria-current={code === locale ? 'true' : undefined}
        title={LOCALE_NAMES[code]}
      >
        {code.toUpperCase()}
        <span class="visually-hidden"> ({LOCALE_NAMES[code]})</span>
      </a>
    ))
  }
</nav>

<style>
  .lang-pill {
    position: relative;
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
  }

  .lang-pill__indicator {
    position: absolute;
    inset: 2px 50% 2px 2px;
    border-radius: var(--radius-pill);
    background: var(--color-surface-raised);
    box-shadow: inset 0 0 0 1px var(--color-accent);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .lang-pill[data-locale='en'] .lang-pill__indicator {
    transform: translateX(100%);
  }

  .lang-pill__option {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3rem;
    min-height: var(--target-min);
    padding-inline: var(--space-3);
    text-decoration: none;
    color: var(--color-text-muted);
    transition: color var(--duration-fast);
  }

  .lang-pill__option:hover {
    color: var(--color-text);
  }

  .lang-pill__option[aria-current='true'] {
    color: var(--color-accent-strong);
  }
</style>
