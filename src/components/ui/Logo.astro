---
import type { Locale } from '../../i18n';
import { t } from '../../i18n';
import { sectionHref } from '../../i18n/routes';
import { publicAssetUrl } from '../../lib/assets';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<!-- El destello de marca (.brand-mark) se define en src/styles/brand.css, compartido con la bienvenida. -->
<a class="logo" href={sectionHref('home', locale)}>
  <span class="brand-mark logo__mark" data-logo-mark>
    <img src={publicAssetUrl('assets/logo/deus-samurai.webp')} alt="" width="40" height="40" />
  </span>
  <span class="logo__name">{t(locale, 'common.siteName')}</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    letter-spacing: 0.02em;
  }

  .logo__mark {
    width: 2.25rem;
    height: 2.25rem;
  }
</style>
