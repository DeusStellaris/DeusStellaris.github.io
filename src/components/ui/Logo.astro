---
import type { Locale } from '../../i18n';
import { t } from '../../i18n';
import { sectionHref } from '../../i18n/routes';
import { publicAssetUrl } from '../../lib/assets';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<a class="logo" href={sectionHref('home', locale)}>
  <img
    class="logo__mark"
    src={publicAssetUrl('assets/logo/deus-logo-placeholder.svg')}
    alt=""
    width="40"
    height="40"
  />
  <span class="logo__name">{t(locale, 'common.siteName')}</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    letter-spacing: 0.02em;
  }

  .logo__mark {
    width: 2.25rem;
    height: 2.25rem;
  }
</style>
