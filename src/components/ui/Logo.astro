---
import type { Locale } from '../../i18n';
import { t } from '../../i18n';
import { sectionHref } from '../../i18n/routes';
import { publicAssetUrl } from '../../lib/assets';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<!--
  data-brand-mark: destino de la animación de bienvenida (src/features/intro/intro.ts).
  El destello (.brand-glint) se dispara una vez al terminar esa animación.
-->
<a class="logo" href={sectionHref('home', locale)}>
  <span class="logo__mark" data-brand-mark>
    <img src={publicAssetUrl('assets/logo/deus-logo-placeholder.svg')} alt="" width="40" height="40" />
  </span>
  <span class="logo__name">{t(locale, 'common.siteName')}</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    letter-spacing: 0.02em;
  }

  .logo__mark {
    position: relative;
    display: inline-flex;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
  }

  .logo__mark img {
    width: 100%;
    height: 100%;
  }

  /* Destello sutil de marca: un único barrido tras la bienvenida, sin bucles. */
  .logo__mark::after {
    content: '';
    position: absolute;
    inset: -40%;
    border-radius: 50%;
    background: radial-gradient(circle, var(--color-accent-strong) 0%, transparent 60%);
    opacity: 0;
    pointer-events: none;
  }

  .logo__mark.brand-glint::after {
    animation: brand-glint 1200ms var(--ease-out) 1;
  }

  @keyframes brand-glint {
    0% {
      opacity: 0;
    }
    40% {
      opacity: 0.45;
    }
    100% {
      opacity: 0;
    }
  }

  /* Mientras corre la bienvenida, el logotipo del header aún no se muestra. */
  :global(html.intro-playing) .logo__mark {
    visibility: hidden;
  }
</style>
