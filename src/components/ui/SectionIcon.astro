---
import type { ContentSectionId } from '../../config/sections';

interface Props {
  section: ContentSectionId;
}

const { section } = Astro.props;
---

{/* Icono identificador de cada sección. Decorativo: el texto del enlace da el nombre. */}
<svg class="section-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" data-section-icon={section}>
  {
    section === 'games' && (
      <path
        d="M12 2 21 7v10l-9 5-9-5V7zM3 7l9 5 9-5M12 12v10"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"
      />
    )
  }
  {
    section === 'programs' && (
      <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="16" rx="2" />
        <path d="M7 9l3 3-3 3M13 15h4" />
      </g>
    )
  }
  {
    section === 'freelance' && (
      <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round">
        <rect x="3" y="7" width="18" height="13" rx="2" />
        <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 13h18" />
      </g>
    )
  }
  {
    section === 'contact' && (
      <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="M3 7l9 6 9-6" />
      </g>
    )
  }
</svg>

<style>
  .section-icon {
    width: 1.125rem;
    height: 1.125rem;
    display: block;
  }
</style>
