---
import type { ContentSectionId } from '../../config/sections';
import SectionIcon from './SectionIcon.astro';

interface Props {
  href: string;
  section: ContentSectionId;
  title: string;
  intro: string;
}

const { href, section, title, intro } = Astro.props;
---

<a class="section-card" href={href} data-card-section={section}>
  <span class="section-card__icon"><SectionIcon section={section} /></span>
  <span class="section-card__title">{title}</span>
  <span class="section-card__intro">{intro}</span>
  <span class="section-card__dust" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
</a>

<style>
  .section-card {
    --card-grow: 1.05;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-height: 11rem;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    text-decoration: none;
    transition:
      border-color var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  /*
   * Expansión lateral: el marco se ensancha sin moverse en vertical y el contenido contrarresta la
   * escala para que la tipografía no se deforme. Solo transform; Lite Mode la deja quieta.
   */
  .section-card:hover {
    border-color: var(--color-accent);
  }

  .section-card:is(:hover, :focus-visible) {
    transform: scaleX(var(--card-grow));
  }

  .section-card > :is(.section-card__icon, .section-card__title, .section-card__intro) {
    transform-origin: left center;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .section-card:is(:hover, :focus-visible)
    > :is(.section-card__icon, .section-card__title, .section-card__intro) {
    transform: scaleX(calc(1 / var(--card-grow)));
  }

  :global(html.lite-mode) .section-card:is(:hover, :focus-visible),
  :global(html.lite-mode)
    .section-card:is(:hover, :focus-visible)
    > :is(.section-card__icon, .section-card__title, .section-card__intro) {
    transform: none;
  }

  .section-card__icon {
    display: inline-flex;
    color: var(--color-accent-strong);
  }

  .section-card__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .section-card__intro {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
