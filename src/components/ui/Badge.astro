---
interface Props {
  /** tech: etiqueta de tecnología. live y wip: estado del proyecto. */
  variant?: 'tech' | 'live' | 'wip';
}

const { variant = 'tech' } = Astro.props;
---

<!-- Etiqueta compacta. El estado se distingue por forma (punto) y texto, no solo por color. -->
<span class:list={['badge', `badge--${variant}`]}><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0.125rem var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface-raised);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: 1.4;
    white-space: nowrap;
  }

  .badge--live,
  .badge--wip {
    color: var(--color-text);
  }

  .badge--live::before,
  .badge--wip::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-violet);
  }

  .badge--wip {
    border-color: var(--color-kintsugi);
  }

  .badge--wip::before {
    background: var(--color-kintsugi);
  }
</style>
