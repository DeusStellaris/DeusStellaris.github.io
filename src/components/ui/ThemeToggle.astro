---
import { type Locale, t } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const labelToLight = t(locale, 'preferences.themeToLight');
const labelToDark = t(locale, 'preferences.themeToDark');
---

<!--
  Selector de tema. Un solo SVG: el icono se transforma con un círculo-máscara.
  El icono NO tiene estado propio: se deriva de <html data-theme> con reglas CSS en la raíz.
  Así el icono correcto existe desde el primer pintado y ninguna recarga ni navegación lo anima
  desde un estado equivocado. JavaScript (src/features/preferences/theme.ts) solo sincroniza la
  etiqueta accesible. Única fuente de verdad: el atributo data-theme del documento.
-->
<button
  type="button"
  class="icon-button theme-toggle"
  data-theme-toggle
  data-label-to-light={labelToLight}
  data-label-to-dark={labelToDark}
  aria-label={labelToLight}
  data-tooltip={labelToLight}
>
  <svg class="theme-toggle__icon" viewBox="0 0 24 24" shape-rendering="geometricPrecision" aria-hidden="true" focusable="false">
    <defs>
      <mask id="theme-toggle-mask">
        <rect x="-10" y="-10" width="44" height="44" fill="#fff" />
        <circle class="theme-toggle__mask" cx="12" cy="12" r="7.3" fill="#000" />
      </mask>
    </defs>
    <circle class="theme-toggle__core" cx="12" cy="12" r="5" fill="currentColor" mask="url(#theme-toggle-mask)" />
    <g class="theme-toggle__rays" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
      <line x1="12" y1="2" x2="12" y2="4" />
      <line x1="12" y1="20" x2="12" y2="22" />
      <line x1="2" y1="12" x2="4" y2="12" />
      <line x1="20" y1="12" x2="22" y2="12" />
      <line x1="4.93" y1="4.93" x2="6.34" y2="6.34" />
      <line x1="17.66" y1="17.66" x2="19.07" y2="19.07" />
      <line x1="4.93" y1="19.07" x2="6.34" y2="17.66" />
      <line x1="17.66" y1="6.34" x2="19.07" y2="4.93" />
    </g>
  </svg>
</button>

<style>
  .theme-toggle__icon {
    width: 1.375rem;
    height: 1.375rem;
  }

  .theme-toggle__mask {
    transition: transform 520ms var(--ease-out);
  }

  .theme-toggle__core {
    transition: transform 520ms var(--ease-out);
    transform-origin: 12px 12px;
    transform-box: view-box;
  }

  .theme-toggle__rays {
    transition:
      opacity 320ms var(--ease-out),
      transform 520ms var(--ease-out);
    transform-origin: 12px 12px;
    transform-box: view-box;
  }

  /*
   * Tema oscuro (por defecto, también sin data-theme): media luna simétrica respecto de la diagonal: la máscara recorta el núcleo.
   * Tema claro (data-theme="light" en <html>): sol completo, la máscara se aleja y aparecen los rayos.
   */
  :root:not([data-theme='light']) .theme-toggle__mask {
    transform: translate(4px, -4px);
  }

  :root[data-theme='light'] .theme-toggle__mask {
    transform: translate(24px, -24px);
  }

  :root:not([data-theme='light']) .theme-toggle__core {
    transform: scale(1.3);
  }

  :root[data-theme='light'] .theme-toggle__core {
    transform: scale(1);
  }

  :root:not([data-theme='light']) .theme-toggle__rays {
    opacity: 0;
    transform: rotate(-60deg) scale(0.4);
  }

  :root[data-theme='light'] .theme-toggle__rays {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
</style>
