---
import { type Locale, t } from '../../i18n';
import SearchWidget from '../search/SearchWidget.astro';

interface Props {
  locale: Locale;
  /** Sección de la página actual, para priorizar sus resultados. */
  context?: 'games' | 'programs' | 'freelance' | 'contact' | undefined;
}

const { locale, context } = Astro.props;
---

<!--
  Asistente flotante (esquina inferior derecha). Usa el mismo buscador que la página de búsqueda.
  El comportamiento lo gestiona src/features/assistant/assistant.ts.
-->
<div class="assistant" data-assistant>
  <button
    type="button"
    class="assistant__opener"
    data-assistant-open
    aria-expanded="false"
    aria-controls="assistant-dialog"
    aria-label={t(locale, 'assistant.open')}
  >
    <svg class="assistant__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.75" />
      <path d="m20 20-4-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
    </svg>
  </button>

  <dialog id="assistant-dialog" class="assistant__dialog" data-assistant-dialog aria-labelledby="assistant-dialog-title">
    <div class="assistant__inner">
      <header class="assistant__header">
        <h2 id="assistant-dialog-title">{t(locale, 'assistant.title')}</h2>
        <button type="button" class="assistant__close" data-assistant-close>{t(locale, 'assistant.close')}</button>
      </header>
      <p class="assistant__intro">{t(locale, 'assistant.intro')}</p>
      {context && <p class="assistant__context">{t(locale, 'assistant.contextHint')}</p>}
      <SearchWidget locale={locale} variant="compact" context={context} />
    </div>
  </dialog>
</div>

<style>
  .assistant {
    position: fixed;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: var(--z-floating);
  }

  .assistant__opener {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-surface-raised);
    color: var(--color-text);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.25);
    cursor: pointer;
    transition: border-color var(--duration-fast), transform var(--duration-fast);
  }

  .assistant__opener:hover {
    border-color: var(--color-accent);
  }

  .assistant__opener:active {
    transform: scale(0.95);
  }

  .assistant__opener[aria-expanded='true'] {
    border-color: var(--color-accent);
  }

  .assistant__icon {
    width: 1.375rem;
    height: 1.375rem;
  }

  .assistant__dialog {
    position: fixed;
    right: var(--space-4);
    bottom: calc(var(--space-4) + 3.25rem + var(--space-3));
    left: auto;
    top: auto;
    width: min(calc(100vw - 2 * var(--gutter)), 24rem);
    max-height: min(70dvh, 36rem);
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.3);
  }

  .assistant__inner {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    overflow-y: auto;
    max-height: min(70dvh, 36rem);
  }

  .assistant__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .assistant__header h2 {
    margin: 0;
    font-size: var(--text-lg);
  }

  .assistant__intro,
  .assistant__context {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .assistant__close {
    min-height: var(--target-min);
    padding-inline: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface-raised);
    color: var(--color-text);
    cursor: pointer;
  }
</style>
