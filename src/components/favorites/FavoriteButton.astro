---
import { type Locale, t } from '../../i18n';

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
---

{/*
  Botón de favorito. Su estado (aria-pressed y etiqueta) lo sincroniza
  src/features/favorites/favorites.ts a partir de localStorage.
*/}
<button
  type="button"
  class="favorite-button"
  data-favorite-toggle
  data-slug={slug}
  data-label-add={t(locale, 'favorites.add')}
  data-label-remove={t(locale, 'favorites.remove')}
  data-msg-added={t(locale, 'favorites.added')}
  data-msg-removed={t(locale, 'favorites.removed')}
  data-msg-unavailable={t(locale, 'favorites.unavailable')}
  aria-pressed="false"
  aria-label={t(locale, 'favorites.add')}
>
  <svg class="favorite-button__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path
      d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z"
      fill="currentColor"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"
    />
  </svg>
</button>

<style>
  .favorite-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--target-min);
    height: var(--target-min);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      color var(--duration-fast),
      border-color var(--duration-fast),
      transform var(--duration-fast);
  }

  .favorite-button:hover {
    border-color: var(--color-accent);
    color: var(--color-text);
  }

  .favorite-button:active {
    transform: scale(0.94);
  }

  .favorite-button[aria-pressed='true'] {
    color: var(--color-accent-strong);
    border-color: var(--color-accent);
  }

  .favorite-button__icon {
    width: 1.125rem;
    height: 1.125rem;
  }

  .favorite-button[aria-pressed='false'] .favorite-button__icon {
    fill: none;
  }
</style>
