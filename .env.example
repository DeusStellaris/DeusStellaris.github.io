# Copiar a `.env` (desarrollo) o configurar en el panel de variables de entorno (producción).
# NUNCA escribir aquí valores reales ni la clave `service_role`.
#
# Variables públicas: se incluyen en el JavaScript del navegador.
# La seguridad de los datos depende de las políticas RLS de Supabase, no de ocultar estas claves.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
